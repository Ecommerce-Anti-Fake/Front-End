# Additive browser-capture variables for the owner-approved UAT/demo runtime.
# Inject account values/passwords/QR through the secure CI environment.
ANTIFAKE_CURRENT_ENVIRONMENT=UAT_DEMO
UAT_APPROVED_PUBLIC_HOSTS=antifake.io.vn,www.antifake.io.vn
UAT_BASE_URL=https://antifake.io.vn
UAT_FIXTURE_SMOKE=true
# Account values are injected only by the secure UAT runtime.
ANTIFAKE_UAT_BUYER_EMAIL=
ANTIFAKE_UAT_BUYER_PASSWORD=
ANTIFAKE_UAT_SELLER_EMAIL=
ANTIFAKE_UAT_SELLER_PASSWORD=
ANTIFAKE_UAT_ADMIN_EMAIL=
ANTIFAKE_UAT_ADMIN_PASSWORD=
UAT_QR_CODE=
